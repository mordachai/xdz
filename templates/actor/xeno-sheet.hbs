<div class="xdz-sheet xdz-xeno-sheet">

  <header class="xdz-header xdz-header-compact">
    <div class="xdz-header-stripes xdz-header-stripes-left"></div>
    <div class="xdz-logo xdz-logo-compact">
      <span class="xdz-logo-xeno">XENO</span>
    </div>
    <div class="xdz-header-stripes xdz-header-stripes-right"></div>
  </header>

  <section class="xdz-xeno-body">
    <div class="xdz-portrait-frame xdz-portrait-frame-small">
      <img class="xdz-portrait" src="{{actor.img}}" data-action="onEditImage" data-edit="img" alt="{{actor.name}}">
    </div>

    <div class="xdz-xeno-fields">
      <label class="xdz-field">
        <span class="xdz-field-label">{{localize 'XDZ.Actor.Name'}}</span>
        <input type="text" name="name" value="{{actor.name}}" {{#unless editable}}disabled{{/unless}}>
      </label>
      <label class="xdz-field">
        <span class="xdz-field-label">{{localize 'XDZ.Xeno.Type'}}</span>
        <input type="text" name="system.xenoType" value="{{system.xenoType}}" placeholder="{{localize 'XDZ.Xeno.TypePlaceholder'}}" {{#unless editable}}disabled{{/unless}}>
      </label>
      <label class="xdz-field">
        <span class="xdz-field-label">{{localize 'XDZ.Xeno.Threat'}}</span>
        <input type="number" name="system.threat" value="{{system.threat}}" min="0" {{#unless editable}}disabled{{/unless}}>
      </label>

      <div class="xdz-xeno-mode">
        <span class="xdz-field-label">{{localize 'XDZ.Xeno.Mode'}}</span>
        <button type="button" class="xdz-mode-toggle xdz-mode-{{system.mode}}" data-action="toggleMode">
          {{localize modeLabel}}
        </button>
      </div>
    </div>

    <label class="xdz-field xdz-field-notes">
      <span class="xdz-field-label">{{localize 'XDZ.Xeno.Notes'}}</span>
      <textarea name="system.notes" rows="4" {{#unless editable}}disabled{{/unless}}>{{system.notes}}</textarea>
    </label>
  </section>

</div>
