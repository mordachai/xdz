<div class="xdz-sheet xdz-commando-sheet xdz-commando-compact" data-theme="{{theme}}">
  <div class="xdz-commando-bg-top">

  <section class="xdz-compact-header">
    <div class="xdz-portrait-frame xdz-portrait-frame-compact">
      <img class="xdz-portrait" src="{{actor.img}}" data-action="onEditImage" data-edit="img" alt="{{actor.name}}">
    </div>

    <div class="xdz-col-identity">
      <label class="xdz-field">
        <span class="xdz-field-label">{{localize 'XDZ.Actor.Name'}}</span>
        <input type="text" name="name" value="{{actor.name}}" {{#unless editable}}disabled{{/unless}}>
      </label>
      <label class="xdz-field">
        <span class="xdz-field-label">{{localize 'XDZ.Actor.Rank'}}</span>
        <input type="text" name="system.rank" value="{{system.rank}}" {{#unless editable}}disabled{{/unless}}>
      </label>
      <label class="xdz-field">
        <span class="xdz-field-label">{{localize 'XDZ.Actor.Quirk'}}</span>
        <input type="text" name="system.quirk" value="{{system.quirk}}" {{#unless editable}}disabled{{/unless}}>
      </label>
    </div>
  </section>

  <div class="xdz-injury-block">
    <div class="xdz-injury-header xdz-hint-trigger">
      <span class="xdz-block-title">{{localize 'XDZ.Actor.Injury'}}</span>
      <p class="xdz-hint-tooltip">
        {{localize 'XDZ.Actor.InjuryHint1'}}<br>
        {{localize 'XDZ.Actor.InjuryHint2'}}
      </p>
    </div>
    <div class="xdz-ecg-panel{{#if system.injuries.dead}} xdz-ecg-dead{{/if}}" style="--xdz-ecg-speed: {{ecgSpeed}}">
      {{#if system.injuries.dead}}
        <span class="xdz-ecg-flag xdz-ecg-flag-dead">{{localize 'XDZ.Actor.KIA'}}</span>
      {{else if system.injuries.down}}
        <span class="xdz-ecg-flag xdz-ecg-flag-down">{{localize 'XDZ.Actor.Down'}}!</span>
      {{/if}}
      <div class="xdz-ecg-row">
        <div class="xdz-ecg-wave-row xdz-ecg-level-{{injuryLevel}}">
          <span class="xdz-ecg-wave"></span>
        </div>
        {{#each injuryPips}}
          <span class="xdz-ecg-pip {{#if filled}}xdz-pip-filled{{/if}}"
                data-action="setPip" data-scope="actor" data-path="injuries.value" data-index="{{index}}"></span>
        {{/each}}
      </div>
    </div>
  </div>

  </div>

  <div class="xdz-commando-bg-content">

  <section class="xdz-compact-stats">
    <div class="xdz-col-training xdz-stat-block">
      <span class="xdz-block-title xdz-block-title-vertical xdz-hint-trigger">
        {{localize 'XDZ.Actor.Training'}}
        <span class="xdz-hint-tooltip">{{localize 'XDZ.Actor.RollOnYourTurn'}}</span>
      </span>
      <div class="xdz-stat-grid-wrap">
        <div class="xdz-stat-grid">
          {{#each trainingRows}}
            {{> "systems/xdz/templates/actor/parts/stat-track.hbs" this}}
          {{/each}}
        </div>
      </div>
    </div>

    <div class="xdz-col-resistance xdz-stat-block">
      <span class="xdz-block-title xdz-block-title-vertical xdz-hint-trigger">
        {{localize 'XDZ.Actor.Resistance'}}
        <span class="xdz-hint-tooltip">{{localize 'XDZ.Actor.RollOnEnemyTurn'}}</span>
      </span>
      <div class="xdz-stat-grid-wrap">
        <div class="xdz-stat-grid">
          {{#each resistanceRows}}
            {{> "systems/xdz/templates/actor/parts/stat-track.hbs" this}}
          {{/each}}
        </div>
      </div>
    </div>
  </section>

  <section class="xdz-loadout">
    <h2 class="xdz-loadout-title xdz-loadout-title-paged">
      <button type="button" class="xdz-page-nav" data-action="loadoutPrev" {{#unless loadoutMultiPage}}disabled{{/unless}}>
        <i class="fa-solid fa-chevron-left"></i>
      </button>
      <span>{{localize 'XDZ.Actor.Loadout'}}</span>
      <button type="button" class="xdz-page-nav" data-action="loadoutNext" {{#unless loadoutMultiPage}}disabled{{/unless}}>
        <i class="fa-solid fa-chevron-right"></i>
      </button>
      <button type="button" class="xdz-title-add" data-action="itemCreate" data-type="weapon" title="{{localize 'XDZ.Actor.AddWeapon'}}">
        <i class="fa-solid fa-plus"></i>
      </button>
    </h2>

    <ul class="xdz-weapon-list">
      {{#each loadoutWeapons}}
        {{> "systems/xdz/templates/actor/parts/weapon-card.hbs" this}}
      {{/each}}
    </ul>

    <h2 class="xdz-loadout-title xdz-gear-title">
      <span>{{localize 'XDZ.Actor.Gear'}}</span>
      <button type="button" class="xdz-title-add" data-action="itemCreate" data-type="gear" title="{{localize 'XDZ.Actor.AddGear'}}">
        <i class="fa-solid fa-plus"></i>
      </button>
    </h2>
    <ul class="xdz-gear-list">
      {{#each gear}}
        <li class="xdz-gear-item" data-item-id="{{this.id}}">
          <span class="xdz-gear-name" data-action="itemEdit">{{this.name}}</span>
          <a class="xdz-item-delete" data-action="itemDelete"><i class="fa-solid fa-trash"></i></a>
        </li>
      {{/each}}
    </ul>
  </section>

  </div>
  <div class="xdz-commando-bg-bottom">
    <div class="xdz-theme-switcher">
      <button type="button" class="xdz-theme-nav" data-action="themePrev">
        <i class="fa-solid fa-chevron-left"></i>
      </button>
      <button type="button" class="xdz-theme-nav" data-action="openHud" title="{{localize 'XDZ.Hud.OpenCompact'}}">
        <i class="fa-solid fa-tablet-screen-button"></i>
      </button>
      <button type="button" class="xdz-theme-nav" data-action="themeNext">
        <i class="fa-solid fa-chevron-right"></i>
      </button>
    </div>
  </div>
</div>
