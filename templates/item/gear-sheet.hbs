<div class="xdz-sheet xdz-item-sheet xdz-gear-item-sheet" data-theme="{{theme}}">

  <header class="xdz-item-header">
    <div class="xdz-portrait-frame xdz-portrait-frame-small">
      <img class="xdz-portrait" src="{{item.img}}" data-action="onEditImage" data-edit="img" alt="{{item.name}}">
    </div>
    <input type="text" class="xdz-item-name" name="name" value="{{item.name}}" {{#unless editable}}disabled{{/unless}}>
    <button type="button" class="xdz-item-header-btn" data-action="onSendToChat" data-tooltip="{{localize 'XDZ.SendToChat'}}">
      <i class="fa-solid fa-comment"></i>
    </button>
  </header>

  <div class="xdz-item-body">
    <label class="xdz-field">
      <span class="xdz-field-label">{{localize 'XDZ.Gear.Quantity'}}</span>
      <input type="number" name="system.quantity" value="{{system.quantity}}" min="0" {{#unless editable}}disabled{{/unless}}>
    </label>

    <label class="xdz-field">
      <span class="xdz-field-label">{{localize 'XDZ.Gear.Description'}}</span>
      <textarea name="system.description" {{#unless editable}}disabled{{/unless}}>{{system.description}}</textarea>
    </label>
  </div>

</div>
