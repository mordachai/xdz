<div class="xdz-chatcard xdz-chatcard-check {{#if success}}xdz-chatcard-hit{{else}}xdz-chatcard-miss{{/if}}" data-theme="{{theme}}">
  <div class="xdz-chatcard-scanlines"></div>
  <div class="xdz-chatcard-header">
    <span class="xdz-chatcard-title">{{label}}</span>
    {{#if tag}}<span class="xdz-chatcard-tag">{{tag}}</span>{{/if}}
  </div>
  <div class="xdz-chatcard-body">
    <div class="xdz-chatcard-line xdz-chatcard-equation">r{{die}} + {{bonusLabel}}{{bonus}} &gt;= {{tn}}?</div>

    <div class="xdz-chatcard-readout">
      <span class="xdz-chatcard-digits">{{total}}</span>
    </div>

    <div class="xdz-chatcard-status {{#if success}}xdz-success{{else}}xdz-failure{{/if}}">
      {{#if success}}{{localize 'XDZ.Roll.Success'}}{{else}}{{localize 'XDZ.Roll.Failure'}}{{/if}}
    </div>
  </div>
</div>
