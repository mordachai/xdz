<div class="xdz-chatcard xdz-chatcard-escalation">
  <div class="xdz-chatcard-scanlines"></div>
  <div class="xdz-chatcard-header">
    <span class="xdz-chatcard-title">{{localize "XDZ.Escalation.Title"}}</span>
    <span class="xdz-chatcard-tag">{{num}}</span>
  </div>
  <div class="xdz-chatcard-body">
    <div class="xdz-chatcard-escalation-label">{{num}}. {{label}}</div>
    <div class="xdz-chatcard-escalation-desc">{{{desc}}}</div>
  </div>
</div>
