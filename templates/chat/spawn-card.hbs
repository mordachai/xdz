<div class="xdz-chatcard xdz-chatcard-spawn" data-theme="{{theme}}">
  <div class="xdz-chatcard-scanlines"></div>
  <div class="xdz-chatcard-header">
    <span class="xdz-chatcard-title">{{localize "XDZ.Chat.SpawnTitle"}}</span>
    <span class="xdz-chatcard-tag">{{localize "XDZ.Chat.SpawnTag"}}</span>
  </div>
  <div class="xdz-chatcard-body">
    <div class="xdz-chatcard-readout xdz-chatcard-spawn-readout">
      <span class="xdz-chatcard-digits">{{total}}</span>
      <span class="xdz-chatcard-digits xdz-chatcard-digits-angle">{{groupCount}}</span>
    </div>

    {{#each groups}}
    <div class="xdz-chatcard-spawn-group">
      <div class="xdz-chatcard-divider">
        <span class="xdz-chatcard-divider-title">x{{count}}</span>
        <span class="xdz-chatcard-divider-fill">////////////////////////////////////////////////////////////</span>
        {{#if ambush}}<span class="xdz-chatcard-tag">{{localize "XDZ.Chat.AmbushTag"}}</span>{{/if}}
      </div>
      <div class="xdz-chatcard-spawn-grid">
        <span class="xdz-chatcard-spawn-die">&lt;{{area}}&gt;</span>
        <span class="xdz-chatcard-spawn-die">&lt;{{location}}&gt;</span>
        <span class="xdz-chatcard-spawn-die">&lt;{{quadrantDie}}&gt;</span>
        <span class="xdz-chatcard-spawn-label">{{areaLabel}}</span>
        <button type="button" class="xdz-chatcard-spawn-label xdz-chatcard-spawn-locbtn" data-action="xdzPanToLocation" data-x="{{x}}" data-y="{{y}}">{{label}}</button>
        <span class="xdz-chatcard-spawn-label">{{quadrantWord}}</span>
      </div>
    </div>
    {{/each}}
  </div>
</div>
