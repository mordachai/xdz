<div class="xdz-chatcard xdz-chatcard-secondary" data-theme="{{theme}}">
  <div class="xdz-chatcard-scanlines"></div>
  <div class="xdz-chatcard-header">
    <span class="xdz-chatcard-title">{{localize "XDZ.Chat.OffMapTitle"}}</span>
    <span class="xdz-chatcard-tag">{{localize "XDZ.Chat.OffMapTag"}}</span>
  </div>
  <div class="xdz-chatcard-body">
    <div class="xdz-chatcard-desc">{{message}}</div>
  </div>
</div>
