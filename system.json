{
  "id": "xdz",
  "title": "Xeno Dead Zone",
  "description": "Non-official Xeno Dead Zone system for Foundry VTT. XENO DEAD ZONE is a one-stop solution to scratch your itch for a night of great gaming in the world of deadly space predators and the badasses who fight them.",
  "version": "2.3.1",
  "authors": [
    {
      "name": "Gus",
      "discord": "gus4294",
      "url": "https://github.com/mordachai",
      "flags": {}
    }
  ],
  "documentTypes": {
    "Actor": {
      "commando": {
        "htmlFields": ["story"]
      },
      "character": {
        "htmlFields": ["story"]
      },
      "xeno": {
        "htmlFields": ["notes"]
      },
      "npc": {
        "htmlFields": ["notes"]
      },
      "vehicle": {
        "htmlFields": ["description"]
      }
    },
    "Item": {
      "weapon": {
        "htmlFields": ["description", "rules"]
      },
      "gear": {
        "htmlFields": ["description"]
      }
    }
  },
  "packs": [
    {
      "name": "npcs",
      "label": "NPCS",
      "path": "packs/npcs",
      "type": "Actor",
      "system": "xdz",
      "banner": "systems/xdz/assets/art/banners/banner_npcs.webp"
    },
    {
      "name": "vehicles",
      "label": "VEHICLES",
      "path": "packs/vehicles",
      "type": "Actor",
      "system": "xdz",
      "banner": "systems/xdz/assets/art/banners/banner_vehicles.webp"
    },
    {
      "name": "assets",
      "label": "ASSETS",
      "path": "packs/assets",
      "type": "Item",
      "system": "xdz",
      "banner": "systems/xdz/assets/art/banners/banner_assets.webp"
    },
    {
      "name": "weapons",
      "label": "WEAPONS",
      "path": "packs/weapons",
      "type": "Item",
      "system": "xdz",
      "banner": "systems/xdz/assets/art/banners/banner_weapons.webp"
    },
    {
      "name": "extragear",
      "label": "EXTRA GEAR",
      "path": "packs/extragear",
      "type": "Item",
      "system": "xdz",
      "banner": "systems/xdz/assets/art/banners/banner_extragear.webp"
    },
    {
      "name": "tables",
      "label": "TABLES",
      "path": "packs/tables",
      "type": "RollTable",
      "system": "xdz",
      "banner": "systems/xdz/assets/art/banners/banner_tables.webp"
    },
    {
      "name": "macros",
      "label": "MACROS",
      "path": "packs/macros",
      "type": "Macro",
      "system": "xdz",
      "banner": "systems/xdz/assets/art/banners/banner_macros.webp"
    },
    {
      "name": "journals",
      "label": "JOURNALS",
      "path": "packs/journals",
      "type": "JournalEntry",
      "system": "xdz",
      "banner": "systems/xdz/assets/art/banners/banner_journals.webp"
    }
  ],
  "packFolders": [
    {
      "name": "Xeno Dead Zone",
      "sorting": "a",
      "color": "#37474f",
      "packs": ["npcs", "vehicles", "assets", "weapons", "extragear", "tables", "macros", "journals"]
    }
  ],
  "flags": {
    "hotReload": {
      "extensions": ["css", "html", "hbs", "json"],
      "paths": ["css", "lang", "templates"]
    }
  },
  "compatibility": {
    "minimum": "13",
    "verified": "14"
  },
  "esmodules": ["module/xdz.mjs"],
  "styles": ["css/xdz.css"],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    },
    {
      "lang": "pt-BR",
      "name": "Português (Brasil)",
      "path": "lang/pt-BR.json"
    }
  ],
  "grid": {
    "distance": 1,
    "units": "zone"
  },
  "media": [
    {
      "type": "setup",
      "url": "systems/xdz/assets/images/splash.webp",
      "thumbnail": "systems/xdz/assets/images/splash.webp",
      "loop": false,
      "flags": {}
    }
  ],
  "primaryTokenAttribute": "injuries",
  "socket": true,
  "url": "https://github.com/mordachai/xdz",
  "manifest": "https://github.com/mordachai/xdz/releases/latest/download/system.json",
  "download": "https://github.com/mordachai/xdz/releases/download/v2.3.1/system.zip",
  "readme": "https://github.com/mordachai/xdz/blob/main/README.md",
  "bugs": "https://github.com/mordachai/xdz/issues",
  "license": "LICENSE"
}
